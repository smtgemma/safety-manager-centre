# Google Sheets CMS Configuration
# Server-only variables: never use the NEXT_PUBLIC_ prefix for these.
#
# VPS setup:
#   cp .env.example .env
#   # then paste the service account private key into GOOGLE_PRIVATE_KEY below
#   docker compose up -d --build
#
# Everything except the private key is already filled in, so there is only one
# value to supply by hand.

# 1. The ID of your Google Sheet (extracted from the URL between /d/ and /edit)
GOOGLE_SHEET_ID=1eTde-dn6wSjSwvlBeYz_glPWI1P2gDBVO-KzHk9yCRk

# 2. The client email from your Google Cloud Service Account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=product-sheet-reader@sheet-510112.iam.gserviceaccount.com

# 3. The private key from your Google Cloud Service Account JSON key.
#    KEEP the surrounding quotes and the literal \n escapes: the app unescapes
#    them itself, and Docker Compose passes the value through verbatim.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_THE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Specific tab name/range. Defaults to 'A1:Z' (first tab) if omitted.
# GOOGLE_SHEET_RANGE=Sheet1!A:Z
